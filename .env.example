# The Wolves' World Cup Superforecaster
# Copy to .env and fill in. Everything boots without keys (mock/fixture mode);
# real keys are only exercised in metered runs.

# Anthropic API (console.anthropic.com). Use a dedicated workspace with a
# spend cap so the workspace limit acts as the hard upstream guardrail.
ANTHROPIC_API_KEY=

# Web search for the forecast agent.
# Exa (dashboard.exa.ai): semantic source-finding.
# Brave (api-dashboard.search.brave.com): fresh news; free tier is 1 req/s.
EXA_API_KEY=
BRAVE_API_KEY=

# Betting odds, the market anchor (the-odds-api.com). Free tier (500
# credits/month) is fine for development.
ODDS_API_KEY=

# Fixtures, results, lineups, injuries (dashboard.api-football.com via
# api-sports.io). Free tier (100 req/day) is fine for development.
API_FOOTBALL_KEY=

# Observability (logfire.pydantic.dev): write token for the project.
LOGFIRE_TOKEN=

# Optional: results cross-check (football-data.org, free tier).
FOOTBALL_DATA_TOKEN=
