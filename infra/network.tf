# Default VPC with public subnets and a public IP keeps the one-off task
# NAT-free; the security group permits nothing inbound.
data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
}

resource "aws_security_group" "engine" {
  name        = "${var.project}-engine"
  description = "Egress-only for the engine task"
  vpc_id      = data.aws_vpc.default.id

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
